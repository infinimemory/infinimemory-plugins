{
  "manifest_version": 3,
  "name": "MemStack",
  "version": "0.2.1",
  "description": "Save pages and selections to MemStack (private parts and secrets removed first), and find them from the toolbar.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://infinimemory.nidonic.online/*",
    "https://recallai.nidonic.online/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MemStack"
  },
  "options_page": "options.html",
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save this page to MemStack"
    }
  },
  "author": "MemStack",
  "externally_connectable": {
    "matches": [
      "https://infinimemory.nidonic.online/*",
      "https://recallai.nidonic.online/*"
    ]
  }
}
